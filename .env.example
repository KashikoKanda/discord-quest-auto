# Account token (not a bot token). Only needed for the CLI.
# Discord web -> DevTools -> Network -> any request -> header "authorization".
TOKEN=

# Bot token, only needed for `npm run bot` (Bot tab in the Discord developer portal).
DISCORD_BOT_TOKEN=

# Optional. Files are written next to the bot by default.
# QUEST_STORE=.quest-store.json
# QUEST_STATE=.quest-state.json
# QUEST_BOT_STORE=.quest-bot.json

# Optional. Proxy list for hidden quests locked to another region.
# Point this at a raw GitHub file and edit that file whenever the list changes:
# the bot reloads it on its own, no restart or redeploy needed.
# PROXY_LIST_URL=https://raw.githubusercontent.com/<user>/<repo>/main/proxies.txt
# or a local file instead of a URL:
# PROXY_LIST_FILE=proxies.txt
# How often to reload the list, in minutes (default 10).
# PROXY_REFRESH_MIN=10
