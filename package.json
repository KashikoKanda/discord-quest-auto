{
	"name": "discord-quest-auto",
	"version": "1.0.0",
	"description": "Completes Discord quests (video, play, activity, achievement) from the terminal using an account token",
	"type": "module",
	"license": "MIT",
	"author": "KashikoKanda",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/KashikoKanda/discord-quest-auto.git"
	},
	"engines": {
		"node": ">=20"
	},
	"keywords": [
		"discord",
		"quests",
		"selfbot",
		"orbs"
	],
	"scripts": {
		"start": "tsx bot.ts",
		"dev": "tsx bot.ts",
		"list": "tsx bot.ts list",
		"auto": "tsx bot.ts auto",
		"status": "tsx bot.ts status",
		"claim": "tsx bot.ts claim",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write \"bot.ts\" \"app.ts\" \"src/**/*.ts\"",
		"format:check": "prettier --check \"bot.ts\" \"app.ts\" \"src/**/*.ts\"",
		"ci": "npm run typecheck && npm run format:check",
		"bot": "tsx app.ts"
	},
	"dependencies": {
		"qrcode": "^1.5.4",
		"sharp": "^0.35.5",
		"undici": "^6.29.1",
		"ws": "^8.21.0"
	},
	"devDependencies": {
		"@types/node": "^24.10.1",
		"@types/qrcode": "^1.5.6",
		"@types/ws": "^8.18.1",
		"prettier": "^3.6.2",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	}
}
